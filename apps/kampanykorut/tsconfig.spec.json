{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.spec.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals", "node", "vite/client"],
    "jsx": "react-jsx",

    "paths": {
      "@logic/*": ["./src/logic/*"],
      "@shared/*": ["../../shared/*"]
    }
  },
  "include": [
    "src/vite-env.d.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "../../shared/**/*.test.ts"
  ]
}

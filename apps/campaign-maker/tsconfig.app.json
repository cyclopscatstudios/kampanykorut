{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",

    "paths": {
      "@shared/*": ["../../shared/*"]
    }
  },
  "include": [
    "src",
    "../../shared/ui",
    "../../shared/types",
    "../../shared/logic",
    "../../shared/logger",
    "../../shared/vite-env.d.ts",
    "public"
  ],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}

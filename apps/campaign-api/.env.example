# Copy to apps/campaign-api/.env for local development. Never commit real secrets.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# Serve the OpenAPI spec and Swagger UI under /api/v1/docs
API_DOCS_ENABLED=true
# Set to true when running behind the nginx reverse proxy
TRUST_PROXY=false

# GitHub App (shared by news sync and bug reports). Leave all three unset to
# disable the GitHub integration; setting only some of them is an error.
# The private key may be given on one line with literal \n separators.
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Repository the app is installed on (owner/name)
GITHUB_REPO=cyclopscatstudios/kampanykorut
# Discussions category the news are synced from (name or slug)
GITHUB_NEWS_CATEGORY=Hírek
# Secret configured on the GitHub App webhook; enables POST /webhooks/github
# GITHUB_WEBHOOK_SECRET=
# Backfill sync of the latest 20 news discussions; 0 disables the scheduler
NEWS_SYNC_INTERVAL_MINUTES=15

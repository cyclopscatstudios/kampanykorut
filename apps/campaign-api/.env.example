# Copy to apps/campaign-api/.env for local development. Never commit real secrets.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# Serve the OpenAPI spec and Swagger UI under /api/v1/docs
API_DOCS_ENABLED=true
# Public site URL, used for canonical and Open Graph links on the news pages
SITE_URL=https://kampanykorut.hu
# Set to true when running behind the nginx reverse proxy
TRUST_PROXY=false

# GitHub App (shared by news sync and bug reports). Leave all three unset to
# disable the GitHub integration; setting only some of them is an error.
# The private key may be given on one line with literal \n separators.
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Repository the app is installed on (owner/name)
GITHUB_REPO=cyclopscatstudios/kampanykorut
# Discussions category the news are synced from (name or slug)
GITHUB_NEWS_CATEGORY=Hírek
# Secret configured on the GitHub App webhook; enables POST /webhooks/github
# GITHUB_WEBHOOK_SECRET=
# Backfill sync of the latest 20 news discussions; 0 disables the scheduler
NEWS_SYNC_INTERVAL_MINUTES=15

# MongoDB for news (and later campaigns). Without it news are kept in memory.
# MONGODB_URI=mongodb://localhost:27017/kampanykorut
# S3-compatible object storage for copied news images (Cloudflare R2, S3, MinIO).
# Leave unset to keep images on local disk in development (.data/assets, served
# under /api/v1/assets) and to show news without images elsewhere.
# Setting only some of them is an error.
# ASSETS_DIR keeps images on local disk in any environment (e.g. a Docker
# volume at /app/data/assets) when S3 is not configured.
# ASSETS_DIR=/app/data/assets
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public (CDN) base URL of the bucket
# ASSETS_PUBLIC_URL=https://cdn.kampanykorut.hu

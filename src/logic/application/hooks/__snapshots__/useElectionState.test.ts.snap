  "currentQuestion": {
    "id": "2022_ogyv-1",
    "possibleAnswers": [
      {
        "id": "A",
        "label": "Nyilvánosan hangsúlyozod a függetlenségedet: „Én senkinek nem vagyok az embere, a pártok csak eszközök a rendszer leváltásához.”",
      },
      {
        "id": "B",
        "label": "Az első nagy kampánybeszédben külön-külön megdicséred az összes részt vevő pártot és vezetőjét: „Mostantól egy csapat vagyunk.”",
      },
      {
        "id": "C",
        "label": "Kijelented, hogy „a régi baloldal is hibázott”, és időnként kritizálod Gyurcsány Ferencet.",
      },
      {
        "id": "D",
        "label": "Először zárt ajtók mögött egyeztetsz a pártelnökökkel, és csak ezután tartasz nagy nyilvános beszédet.",
      },
    ],
    "question": "2021 őszén megnyered az ellenzéki előválasztást, így te leszel az összefogás közös miniszterelnök-jelöltje. A pártok között még van bizalmatlanság, de a nyilvánosságban nagy a várakozás.",
    "title": "Elfogadod-e a közös jelöltséget?",
  },
